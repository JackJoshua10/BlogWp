---
import { profile, stats, capabilities } from "../data/cv";
import SectionHeading from "./SectionHeading.astro";
import Icon from "./Icon.astro";
---

<section id="sobre-mi" class="relative z-10 mx-auto max-w-5xl px-6 py-20 sm:py-24">
  <SectionHeading index="01" title="Sobre mí" subtitle="Quién soy y qué puedo aportar a tu equipo" />

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-4">
    <!-- bio -->
    <div
      class="reveal col-span-2 row-span-2 rounded-2xl border border-slate-200 bg-gradient-to-br from-slate-50 to-white p-6 sm:p-8 dark:border-white/10 dark:from-white/[0.04] dark:to-white/[0.01]"
    >
      <p class="text-lg leading-relaxed text-slate-700 sm:text-xl dark:text-slate-200">
        Soy <span class="font-semibold text-brand">{profile.tagline.toLowerCase()}</span>, enfocado
        en construir interfaces sólidas con JavaScript, React, Tailwind y WordPress.
      </p>
      <p class="mt-4 text-sm leading-relaxed text-slate-500 dark:text-slate-400">
        Integro esas interfaces con backends y ERPs como Odoo, aplico IA (Claude) para reducir
        deuda técnica, y trabajo bajo metodologías ágiles con documentación técnica y control de
        versiones en Git/GitHub.
      </p>
    </div>

    <!-- stats -->
    {
      stats.map((stat) => (
        <div
          class="reveal col-span-1 flex flex-col justify-center rounded-2xl border border-slate-200 bg-slate-50 p-4 text-center dark:border-white/10 dark:bg-white/[0.03]"
        >
          <p class="text-2xl font-bold text-brand sm:text-3xl">{stat.value}</p>
          <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">{stat.label}</p>
        </div>
      ))
    }
  </div>

  <!-- capabilities -->
  <div class="mt-4 grid grid-cols-2 gap-4 lg:grid-cols-4">
    {
      capabilities.map((capability, i) => (
        <div
          class="reveal group rounded-2xl border border-slate-200 bg-slate-50 p-5 hover:-translate-y-1 hover:border-brand/40 hover:shadow-lg hover:shadow-brand/10 dark:border-white/10 dark:bg-white/[0.03]"
          style={`transition-delay: ${i * 60}ms`}
        >
          <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-brand/10 text-brand transition group-hover:bg-brand group-hover:text-white">
            <Icon name={capability.icon as "code" | "cube" | "sparkles" | "cycle"} class="h-5 w-5" />
          </div>
          <h3 class="mt-4 text-sm font-semibold text-slate-900 dark:text-slate-100">{capability.title}</h3>
          <p class="mt-1.5 text-xs leading-relaxed text-slate-500 dark:text-slate-400">
            {capability.description}
          </p>
        </div>
      ))
    }
  </div>
</section>
