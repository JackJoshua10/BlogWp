---
import { skills } from "../data/cv";
import SectionHeading from "./SectionHeading.astro";
import Icon from "./Icon.astro";

const entries = Object.entries(skills);
const icons = ["code", "cube", "sparkles", "cycle", "grid"] as const;
---

<section id="habilidades" class="relative z-10 mx-auto max-w-5xl px-6 py-20 sm:py-24">
  <SectionHeading index="04" title="Habilidades técnicas" subtitle="Stack y herramientas que uso día a día" />

  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {
      entries.map(([category, items], i) => (
        <div
          class="reveal rounded-2xl border border-slate-200 bg-slate-50 p-5 hover:border-brand/30 dark:border-white/10 dark:bg-white/[0.03]"
          style={`transition-delay: ${i * 70}ms`}
        >
          <div class="flex items-center gap-2.5">
            <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-brand/10 text-brand">
              <Icon name={icons[i % icons.length]} class="h-4 w-4" />
            </div>
            <h3 class="text-sm font-semibold text-slate-900 dark:text-slate-100">{category}</h3>
          </div>
          <div class="mt-4 flex flex-wrap gap-2">
            {items.map((item) => (
              <span class="rounded-full border border-brand/20 bg-brand/5 px-3 py-1 text-xs text-brand transition hover:bg-brand/15">
                {item}
              </span>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</section>
