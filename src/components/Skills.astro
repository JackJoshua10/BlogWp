---
import { skills } from "../data/cv";

const entries = Object.entries(skills);
---

<section id="habilidades" class="relative z-10 mx-auto max-w-5xl px-6 py-16">
  <h2 class="reveal text-sm font-semibold uppercase tracking-widest text-brand">Habilidades técnicas</h2>
  <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {
      entries.map(([category, items], i) => (
        <div
          class="reveal rounded-xl border border-slate-200 bg-slate-50 p-5 hover:border-brand/30 dark:border-white/5 dark:bg-white/[0.02]"
          style={`transition-delay: ${i * 70}ms`}
        >
          <h3 class="text-sm font-semibold text-slate-900 dark:text-slate-100">{category}</h3>
          <div class="mt-3 flex flex-wrap gap-2">
            {items.map((item) => (
              <span class="rounded-full border border-brand/20 bg-brand/5 px-3 py-1 text-xs text-brand transition hover:bg-brand/15">
                {item}
              </span>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</section>
