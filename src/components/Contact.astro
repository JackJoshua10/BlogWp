---
import { profile } from "../data/cv";
import SectionHeading from "./SectionHeading.astro";

const links = [
  { label: "Email", value: profile.email, href: `mailto:${profile.email}` },
  { label: "Teléfono", value: profile.phone, href: `tel:+51${profile.phone}` },
  { label: "LinkedIn", value: "jack-joshua-sivipaucar-quilluya", href: profile.linkedin },
  { label: "GitHub", value: "JackJoshua10", href: profile.github },
];
---

<section id="contacto" class="relative z-10 mx-auto max-w-5xl px-6 py-20 sm:py-24">
  <SectionHeading index="05" title="Contacto" subtitle="¿Tienes un proyecto o una oportunidad? Escríbeme." />

  <div class="reveal relative overflow-hidden rounded-3xl border border-slate-200 bg-gradient-to-br from-slate-50 to-white p-6 sm:p-10 dark:border-white/10 dark:from-white/[0.05] dark:to-white/[0.01]">
    <div class="pointer-events-none absolute -right-16 -top-16 h-56 w-56 rounded-full bg-brand/10 blur-3xl"></div>

    <p class="max-w-xl text-slate-600 dark:text-slate-300">
      Respondo rápido por correo o LinkedIn. También puedes descargar mi CV si prefieres revisarlo
      con calma.
    </p>

    <div class="mt-8 grid gap-4 sm:grid-cols-2">
      {
        links.map((link, i) => (
          <a
            href={link.href}
            target={link.href.startsWith("http") ? "_blank" : undefined}
            rel="noopener noreferrer"
            class="reveal flex items-center justify-between rounded-xl border border-slate-200 bg-white p-4 hover:-translate-y-0.5 hover:border-brand/40 hover:shadow-lg hover:shadow-brand/10 dark:border-white/10 dark:bg-white/[0.03]"
            style={`transition-delay: ${i * 70}ms`}
          >
            <span class="text-sm text-slate-500">{link.label}</span>
            <span class="text-sm font-medium text-slate-800 dark:text-slate-200">{link.value}</span>
          </a>
        ))
      }
    </div>

    <a
      href={profile.cvUrl}
      download
      class="mt-8 inline-flex items-center gap-2 rounded-full bg-brand px-6 py-3 text-sm font-semibold text-white transition hover:-translate-y-0.5 hover:shadow-lg hover:shadow-brand/30"
    >
      Descargar CV
    </a>
  </div>
</section>
