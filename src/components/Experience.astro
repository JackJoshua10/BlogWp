---
import { experience, education } from "../data/cv";
---

<section id="experiencia" class="mx-auto max-w-5xl px-6 py-16">
  <h2 class="text-sm font-semibold uppercase tracking-widest text-brand">Experiencia</h2>
  <ol class="mt-6 space-y-8 border-l border-white/10 pl-6">
    {
      experience.map((job) => (
        <li class="relative">
          <span class="absolute -left-[1.65rem] top-1.5 h-2.5 w-2.5 rounded-full bg-brand" />
          <p class="text-xs font-medium uppercase tracking-wide text-slate-500">{job.period}</p>
          <h3 class="mt-1 text-base font-semibold text-slate-100">{job.role}</h3>
          <p class="text-sm text-brand/90">{job.company}</p>
          <ul class="mt-3 space-y-1.5">
            {job.bullets.map((bullet) => (
              <li class="text-sm text-slate-400">· {bullet}</li>
            ))}
          </ul>
        </li>
      ))
    }
  </ol>

  <h2 class="mt-16 text-sm font-semibold uppercase tracking-widest text-brand">Formación</h2>
  <div class="mt-6 rounded-xl border border-white/5 bg-white/[0.02] p-6">
    <p class="text-xs font-medium uppercase tracking-wide text-slate-500">{education.period}</p>
    <h3 class="mt-1 text-base font-semibold text-slate-100">{education.degree}</h3>
    <p class="text-sm text-brand/90">{education.school}</p>
  </div>
  <div class="mt-4 grid gap-3 sm:grid-cols-3">
    {
      education.extra.map((item) => (
        <div class="rounded-lg border border-white/5 bg-white/[0.02] p-4">
          <p class="text-xs text-slate-500">{item.period}</p>
          <p class="mt-1 text-sm font-medium text-slate-200">{item.title}</p>
          <p class="text-xs text-slate-400">{item.school}</p>
        </div>
      ))
    }
  </div>
</section>
