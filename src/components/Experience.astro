---
import { experience, education } from "../data/cv";
---

<section id="experiencia" class="relative z-10 mx-auto max-w-5xl px-6 py-16">
  <h2 class="reveal text-sm font-semibold uppercase tracking-widest text-brand">Experiencia</h2>
  <ol class="mt-6 space-y-8 border-l border-slate-200 pl-6 dark:border-white/10">
    {
      experience.map((job, i) => (
        <li class="reveal relative" style={`transition-delay: ${i * 80}ms`}>
          <span class="absolute -left-[1.65rem] top-1.5 h-2.5 w-2.5 rounded-full bg-brand shadow-[0_0_0_4px] shadow-brand/15" />
          <p class="text-xs font-medium uppercase tracking-wide text-slate-500">{job.period}</p>
          <h3 class="mt-1 text-base font-semibold text-slate-900 dark:text-slate-100">{job.role}</h3>
          <p class="text-sm text-brand/90">{job.company}</p>
          <ul class="mt-3 space-y-1.5">
            {job.bullets.map((bullet) => (
              <li class="text-sm text-slate-500 dark:text-slate-400">· {bullet}</li>
            ))}
          </ul>
        </li>
      ))
    }
  </ol>

  <h2 class="reveal mt-16 text-sm font-semibold uppercase tracking-widest text-brand">Formación</h2>
  <div class="reveal mt-6 rounded-xl border border-slate-200 bg-slate-50 p-6 dark:border-white/5 dark:bg-white/[0.02]">
    <p class="text-xs font-medium uppercase tracking-wide text-slate-500">{education.period}</p>
    <h3 class="mt-1 text-base font-semibold text-slate-900 dark:text-slate-100">{education.degree}</h3>
    <p class="text-sm text-brand/90">{education.school}</p>
  </div>
  <div class="mt-4 grid gap-3 sm:grid-cols-3">
    {
      education.extra.map((item, i) => (
        <div
          class="reveal rounded-lg border border-slate-200 bg-slate-50 p-4 dark:border-white/5 dark:bg-white/[0.02]"
          style={`transition-delay: ${i * 80}ms`}
        >
          <p class="text-xs text-slate-500">{item.period}</p>
          <p class="mt-1 text-sm font-medium text-slate-800 dark:text-slate-200">{item.title}</p>
          <p class="text-xs text-slate-500 dark:text-slate-400">{item.school}</p>
        </div>
      ))
    }
  </div>
</section>
