---
import { experience, education } from "../data/cv";
import SectionHeading from "./SectionHeading.astro";
---

<section id="experiencia" class="relative z-10 mx-auto max-w-5xl px-6 py-20 sm:py-24">
  <SectionHeading index="03" title="Experiencia" subtitle="Trayectoria profesional en orden cronológico" />

  <ol class="space-y-8 border-l border-slate-200 pl-6 dark:border-white/10">
    {
      experience.map((job, i) => (
        <li class="reveal relative" style={`transition-delay: ${i * 80}ms`}>
          <span class="absolute -left-[1.71rem] top-1.5 h-3 w-3 rounded-full border-2 border-white bg-brand shadow-[0_0_0_4px] shadow-brand/15 dark:border-ink" />
          <div class="flex flex-wrap items-center gap-2">
            <p class="text-xs font-medium uppercase tracking-wide text-slate-500">{job.period}</p>
            {i === 0 && (
              <span class="rounded-full bg-brand/10 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-brand">
                Actual
              </span>
            )}
          </div>
          <h3 class="mt-1 text-base font-semibold text-slate-900 dark:text-slate-100">{job.role}</h3>
          <p class="text-sm text-brand/90">{job.company}</p>
          <ul class="mt-3 space-y-1.5">
            {job.bullets.map((bullet) => (
              <li class="text-sm text-slate-500 dark:text-slate-400">· {bullet}</li>
            ))}
          </ul>
        </li>
      ))
    }
  </ol>

  <div class="reveal mt-16 mb-6 flex items-center gap-3">
    <h3 class="text-sm font-semibold uppercase tracking-widest text-brand">Formación</h3>
    <div class="h-px flex-1 bg-brand/20"></div>
  </div>
  <div class="reveal rounded-2xl border border-slate-200 bg-gradient-to-br from-slate-50 to-white p-6 dark:border-white/10 dark:from-white/[0.04] dark:to-white/[0.01]">
    <p class="text-xs font-medium uppercase tracking-wide text-slate-500">{education.period}</p>
    <h3 class="mt-1 text-base font-semibold text-slate-900 dark:text-slate-100">{education.degree}</h3>
    <p class="text-sm text-brand/90">{education.school}</p>
  </div>
  <div class="mt-4 grid gap-3 sm:grid-cols-3">
    {
      education.extra.map((item, i) => (
        <div
          class="reveal rounded-xl border border-slate-200 bg-slate-50 p-4 dark:border-white/10 dark:bg-white/[0.03]"
          style={`transition-delay: ${i * 80}ms`}
        >
          <p class="text-xs text-slate-500">{item.period}</p>
          <p class="mt-1 text-sm font-medium text-slate-800 dark:text-slate-200">{item.title}</p>
          <p class="text-xs text-slate-500 dark:text-slate-400">{item.school}</p>
        </div>
      ))
    }
  </div>
</section>
