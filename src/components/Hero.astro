---
import { profile } from "../data/cv";
---

<section id="top" class="mx-auto flex max-w-5xl flex-col-reverse items-center gap-10 px-6 py-20 md:flex-row md:py-28">
  <div class="flex-1 text-center md:text-left">
    <p class="mb-3 text-sm font-medium uppercase tracking-widest text-brand">
      {profile.location} · Ingeniería de Sistemas e Informática
    </p>
    <h1 class="text-4xl font-bold tracking-tight text-slate-50 sm:text-5xl">
      {profile.name}
    </h1>
    <p class="mt-4 text-lg text-slate-300">{profile.title}</p>
    <p class="mt-4 max-w-xl text-slate-400 md:mx-0">
      {profile.tagline}. Construyo interfaces web sólidas y estoy ampliando mi
      experiencia backend mientras termino mi carrera de Ingeniería de
      Sistemas e Informática.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3 md:justify-start">
      <a
        href="#proyectos"
        class="rounded-full bg-brand px-5 py-2.5 text-sm font-semibold text-ink transition hover:opacity-90"
      >
        Ver proyectos
      </a>
      <a
        href="#contacto"
        class="rounded-full border border-white/15 px-5 py-2.5 text-sm font-semibold text-slate-200 transition hover:border-brand/50 hover:text-brand"
      >
        Contactarme
      </a>
    </div>
  </div>
  <div
    class="h-40 w-40 shrink-0 overflow-hidden rounded-full border border-brand/30 bg-gradient-to-br from-brand/20 to-transparent sm:h-52 sm:w-52"
  >
    <img
      src="/foto-cv.jpg"
      alt={profile.name}
      class="h-full w-full object-cover"
      width="208"
      height="208"
    />
  </div>
</section>
