---
import { projects } from "../data/cv";
---

<section id="proyectos" class="relative z-10 mx-auto max-w-5xl px-6 py-16">
  <h2 class="reveal text-sm font-semibold uppercase tracking-widest text-brand">Proyectos</h2>
  <div class="mt-6 grid gap-6 sm:grid-cols-2">
    {
      projects.map((project, i) => (
        <article
          class="reveal group flex flex-col rounded-xl border border-slate-200 bg-slate-50 p-6 hover:-translate-y-1 hover:border-brand/40 hover:shadow-xl hover:shadow-brand/10 dark:border-white/5 dark:bg-white/[0.02]"
          style={`transition-delay: ${i * 70}ms`}
        >
          <h3 class="text-lg font-semibold text-slate-900 dark:text-slate-100">{project.title}</h3>
          <p class="mt-2 flex-1 text-sm text-slate-500 dark:text-slate-400">{project.description}</p>
          {project.highlight && (
            <p class="mt-3 text-xs font-medium text-brand">{project.highlight}</p>
          )}
          <div class="mt-4 flex flex-wrap gap-2">
            {project.tags.map((tag) => (
              <span class="rounded-full bg-slate-200/70 px-2.5 py-1 text-xs text-slate-600 dark:bg-white/5 dark:text-slate-300">
                {tag}
              </span>
            ))}
          </div>
          {project.link && (
            <a
              href={project.link}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-brand group-hover:gap-2 group-hover:underline"
            >
              Ver proyecto →
            </a>
          )}
        </article>
      ))
    }
  </div>
</section>
