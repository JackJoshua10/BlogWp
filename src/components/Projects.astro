---
import { projects } from "../data/cv";
---

<section id="proyectos" class="mx-auto max-w-5xl px-6 py-16">
  <h2 class="text-sm font-semibold uppercase tracking-widest text-brand">Proyectos</h2>
  <div class="mt-6 grid gap-6 sm:grid-cols-2">
    {
      projects.map((project) => (
        <article class="flex flex-col rounded-xl border border-white/5 bg-white/[0.02] p-6 transition hover:border-brand/30">
          <h3 class="text-lg font-semibold text-slate-100">{project.title}</h3>
          <p class="mt-2 flex-1 text-sm text-slate-400">{project.description}</p>
          {project.highlight && (
            <p class="mt-3 text-xs font-medium text-brand">{project.highlight}</p>
          )}
          <div class="mt-4 flex flex-wrap gap-2">
            {project.tags.map((tag) => (
              <span class="rounded-full bg-white/5 px-2.5 py-1 text-xs text-slate-300">
                {tag}
              </span>
            ))}
          </div>
          {project.link && (
            <a
              href={project.link}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-brand hover:underline"
            >
              Ver proyecto →
            </a>
          )}
        </article>
      ))
    }
  </div>
</section>
