---
interface Props {
  index: string;
  title: string;
  subtitle?: string;
}

const { index, title, subtitle } = Astro.props;
---

<div class="reveal mb-10">
  <div class="mb-3 flex items-center gap-3">
    <span class="font-mono text-sm font-medium text-brand">{index}</span>
    <div class="h-px w-10 bg-brand/40"></div>
  </div>
  <h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl dark:text-slate-50">
    {title}
  </h2>
  {subtitle && <p class="mt-2 max-w-lg text-sm text-slate-500 dark:text-slate-400">{subtitle}</p>}
</div>
